#
# Copyright (C) 2025 The TeamWin Recovery Project
#
# TWRP fstab for xiaomi monet (lito)
# Sources verified against the running device /vendor/etc/fstab.qcom
#
# Logical partitions are referenced by their device-mapper paths
# (/dev/block/mapper/*) instead of the "logical" flag: TWRP's
# Prepare_Super_Volume path fails on this device (dm devices are only
# mapped later, during FBE metadata decryption), which previously caused
# the partitions to be dropped from the list.
#
# SPDX-License-Identifier: Apache-2.0
#
#<src>                                                 <mnt_point>            <type>  <mnt_flags and options>                                                                                  <fs_mgr_flags>

# Logical partitions (dynamic, mapped to dm devices after metadata decrypt)
/dev/block/mapper/system                               /system_root           ext4    ro,barrier=1,discard                                                                                   wait,backup=1
/dev/block/mapper/system_ext                           /system_ext            ext4    ro,barrier=1,discard                                                                                   wait,backup=1
/dev/block/mapper/product                              /product               ext4    ro,barrier=1,discard                                                                                   wait,backup=1
/dev/block/mapper/vendor                               /vendor                ext4    ro,barrier=1,discard                                                                                   wait,backup=1
/dev/block/mapper/odm                                  /odm                   ext4    ro,barrier=1,discard                                                                                   wait,backup=1

# FBE metadata
/dev/block/bootdevice/by-name/metadata                  /metadata              ext4    noatime,nosuid,nodev,discard                                                                           wait,check,formattable

# Data (FBE v2 inline hardware crypto, metadata-wrapped)
# "storage" flag: in fastbootd mode TWRP skips Setup_Fstab_Partitions, so
# /data would never be marked as storage and the empty default storage path
# triggers "Unable to locate storage device." on the fastboot page. With the
# flag the partition is always Is_Storage; normal mode later overrides
# Storage_Path to /data/media/0 via Setup_Data_Media.
/dev/block/bootdevice/by-name/userdata                  /data                  f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt           latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs,storage

# Cache
/dev/block/bootdevice/by-name/cache                     /cache                 ext4    nosuid,noatime,nodev,barrier=1                                                                         wait,backup=1

# Image partitions (flash + image backup)
/dev/block/bootdevice/by-name/boot                      /boot                  emmc    defaults                                                                                               defaults,backup=1
/dev/block/bootdevice/by-name/recovery                  /recovery              emmc    defaults                                                                                               defaults
/dev/block/bootdevice/by-name/dtbo                      /dtbo                  emmc    defaults                                                                                               defaults,backup=1
/dev/block/bootdevice/by-name/vbmeta                    /vbmeta                emmc    defaults                                                                                               defaults,backup=1
/dev/block/bootdevice/by-name/misc                      /misc                  emmc    defaults                                                                                               defaults
