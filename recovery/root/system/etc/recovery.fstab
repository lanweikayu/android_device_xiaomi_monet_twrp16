#
# Copyright (C) 2025 The TeamWin Recovery Project
#
# TWRP fstab for xiaomi monet (lito)
# Sources verified against the running device /vendor/etc/fstab.qcom
#
# Logical partitions use their device-mapper paths (/dev/block/mapper/*)
# together with the "logical" flag (see the section below for why this is
# safe on monet).  create_lp maps the dm devices in init.recovery.qcom.rc
# before TWRP starts, so TWRP's super-partition handling finds them.
#
# SPDX-License-Identifier: Apache-2.0
#
#<src>                                                 <mnt_point>            <type>  <mnt_flags and options>                                                                                  <fs_mgr_flags>

# Logical partitions (dynamic, mapped to dm devices after metadata decrypt)
#
# Unlike the original design (plain /dev/block/mapper/* entries with no
# logical flag), these entries carry the TWRP "logical" flag.  create_lp
# (init.recovery.qcom.rc, "on fs") maps all logical partitions from the
# super metadata BEFORE TWRP's GUI starts, so Prepare_Super_Volume's
# fs_mgr_update_logical_partition()/GetDmDevicePathByName() find the
# already-existing /dev/block/dm-N devices and never block or fail.  This
# makes TWRP treat them as super sub-partitions:
#   - the "Super (...)" display name lists the logical partitions,
#   - restores of those backups resolve correctly,
#   - the partitions can no longer be backed up individually (they are
#     backed up together with the /super image instead).
# Image flashing of logical partitions is done through the /super partition
# (TWRP's Flash_Image rejects file-system partitions), so no flashimg flag
# is added here - the "Install Image" target picker offers the Super image.
# "ro" is intentionally dropped so TWRP can mount them read-write (ext4) or
# read-only (erofs, inherently).  The fs type is declared as erofs for the
# upcoming erofs-packaged logical partitions; TWRP's blkid re-detects the
# real on-disk type (erofs.c is compiled in), so the current ext4 images
# keep mounting normally.
/dev/block/mapper/system                               /system_root           erofs    barrier=1,discard                                                                                     wait,backup=1,logical
/dev/block/mapper/system_ext                           /system_ext            erofs    barrier=1,discard                                                                                     wait,backup=1,logical
/dev/block/mapper/product                              /product               erofs    barrier=1,discard                                                                                     wait,backup=1,logical
/dev/block/mapper/vendor                               /vendor                erofs    barrier=1,discard                                                                                     wait,backup=1,logical
/dev/block/mapper/odm                                  /odm                   erofs    barrier=1,discard                                                                                     wait,backup=1,logical

# FBE metadata
/dev/block/bootdevice/by-name/metadata                  /metadata              ext4    noatime,nosuid,nodev,discard                                                                           wait,check,formattable

# Data (FBE v2 inline hardware crypto, metadata-wrapped)
# "storage" flag: in fastbootd mode TWRP skips Setup_Fstab_Partitions, so
# /data would never be marked as storage and the empty default storage path
# triggers "Unable to locate storage device." on the fastboot page. With the
# flag the partition is always Is_Storage; normal mode later overrides
# Storage_Path to /data/media/0 via Setup_Data_Media.
/dev/block/bootdevice/by-name/userdata                  /data                  f2fs    noatime,nosuid,nodev,discard,reserve_root=32768,resgid=1065,fsync_mode=nobarrier,inlinecrypt           latemount,wait,check,formattable,fileencryption=aes-256-xts:aes-256-cts:v2+inlinecrypt_optimized,keydirectory=/metadata/vold/metadata_encryption,quota,reservedsize=128M,sysfs_path=/sys/devices/platform/soc/1d84000.ufshc,checkpoint=fs,storage

# Cache
/dev/block/bootdevice/by-name/cache                     /cache                 ext4    nosuid,noatime,nodev,barrier=1                                                                         wait,backup=1

# Image partitions (flash + image backup)
# dtbo and all five vbmeta partitions carry the "flashimg" flag so they show
# up in the "Install Image" target picker (TWRP's stock code only enables
# Can_Flash_Img for boot/init_boot/recovery/system_image/vendor_image; these
# are emmc image partitions with Backup_Method dd, so flashing works out of
# the box) and "backup" so they can be backed up individually.
/dev/block/bootdevice/by-name/boot                      /boot                  emmc    defaults                                                                                               defaults,backup=1
/dev/block/bootdevice/by-name/recovery                  /recovery              emmc    defaults                                                                                               defaults
/dev/block/bootdevice/by-name/dtbo                      /dtbo                  emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/vbmeta                    /vbmeta                emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/vbmeta_system             /vbmeta_system         emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/vbmeta_vendor             /vbmeta_vendor         emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/vbmeta_odm                /vbmeta_odm            emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/vbmeta_product            /vbmeta_product        emmc    defaults                                                                                               defaults,backup=1,flashimg
/dev/block/bootdevice/by-name/misc                      /misc                  emmc    defaults                                                                                               defaults
